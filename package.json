{
  "name": "lantern-sea",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "foundry:install": "node scripts/install-foundry.mjs",
    "forge": "node scripts/tool.mjs forge",
    "cast": "node scripts/tool.mjs cast",
    "build:contracts": "node scripts/tool.mjs forge build",
    "test:contracts": "node scripts/tool.mjs forge test -vv",
    "abi": "node scripts/sync-abi.mjs",
    "local": "node scripts/local.mjs",
    "local:lan": "node scripts/local.mjs --lan",
    "test:e2e": "node scripts/e2e.mjs",
    "test:deploy": "node scripts/test-deploy.mjs",
    "test:ui": "playwright test",
    "config:testnet": "node scripts/config-testnet.mjs",
    "dev": "vite web --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p test/browser/tsconfig.json && vite build web",
    "preview": "vite preview web --host 127.0.0.1",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run test:contracts && npm run abi && npm run build"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "phaser": "3.90.0",
    "qrcode": "1.5.4",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/qrcode": "1.5.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
