# Public testnet settings only. Never put private keys here.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
GAME_RPC_URL=https://REPLACE_WITH_YOUR_GAME_L1_RPC
GAME_CHAIN_ID=202611
GAME_GAS_SYMBOL=GAME
GAME_EXPLORER_URL=

# Run cast call <WARP> "getBlockchainID()(bytes32)" --rpc-url ... to get these.
# Avalanche blockchain ID (bytes32) is DIFFERENT from EVM chain ID (number).
GAME_BLOCKCHAIN_ID=0xREPLACE_WITH_64_HEX_DIGITS
VAULT_BLOCKCHAIN_ID=0xREPLACE_WITH_64_HEX_DIGITS

# Confirm both are the same supported Teleporter version; deploy on Game L1 through official tools.
GAME_MESSENGER=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf
VAULT_MESSENGER=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf
DEPLOYER=0xREPLACE_WITH_YOUR_TEST_WALLET_ADDRESS
DEMO_MODE=true

# Fill after Foundry deployment, then bind the two peers once.
FARM_ADDRESS=0xREPLACE_WITH_FARM_ADDRESS
VAULT_ADDRESS=0xREPLACE_WITH_VAULT_ADDRESS
TOKEN_ADDRESS=0xREPLACE_WITH_DEMO_USD_ADDRESS
RUN_FUJI_SMOKE=false
