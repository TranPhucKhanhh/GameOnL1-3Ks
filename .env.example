# Public testnet settings only. Never put private keys here; sign with `cast wallet` / --account instead.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
GAME_RPC_URL=https://REPLACE_WITH_YOUR_GAME_L1_RPC
GAME_CHAIN_ID=202611
# Name wallets show for the game chain (e.g. Dispatch when using Avalanche's public test L1).
GAME_CHAIN_NAME=Lantern Sea L1
GAME_GAS_SYMBOL=TIDE
GAME_EXPLORER_URL=

# Avalanche blockchain IDs (bytes32), NOT EVM chain IDs. Get each with:
#   cast call 0x0200000000000000000000000000000000000005 "getBlockchainID()(bytes32)" --rpc-url <RPC>
GAME_BLOCKCHAIN_ID=0xREPLACE_WITH_64_HEX_DIGITS
ESCROW_BLOCKCHAIN_ID=0xREPLACE_WITH_FUJI_C_CHAIN_BLOCKCHAIN_ID

# Teleporter messenger on each chain (same version on both). Fuji's is the official address below;
# for your L1, use the address the Builder Console ICM setup shows.
GAME_MESSENGER=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf
ESCROW_MESSENGER=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf

# Circle test USDC on Fuji (faucet.circle.com). Double-check the address in Circle's docs before deploying.
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

DEPLOYER=0xREPLACE_WITH_YOUR_TEST_WALLET_ADDRESS
DEMO_MODE=true
MAP_SIZE=256
# Any bytes32; changing it creates a different sea.
WORLD_SEED=0x6c616e7465726e2d7365612d64656d6f2d776f726c642d763100000000000000

# Fill after Forge deployment (see docs/deployment.md), then run BindGamePeer and BindEscrowPeer once.
SEA_ADDRESS=0xREPLACE
COOP_ADDRESS=0xREPLACE
SHIPYARD_ADDRESS=0xREPLACE
RAID_ADDRESS=0xREPLACE
ESCROW_ADDRESS=0xREPLACE
